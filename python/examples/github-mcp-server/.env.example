# Interface and port this MCP server listens on. Whatever the proxy dials must
# match, because the proxy's `dst_addr` becomes the token's `dst`, and the gateway
# looks up the credential by that host. 8788 rather than 8787 so this can run
# beside the Node demo.
HOST=127.0.0.1
PORT=8788

# Control plane's redemption endpoint.
KEYDRIS_GATEWAY_URL=http://localhost:8080/gateway/credentials

# The header the proxy injects the access token on. Must match the control
# plane's ACCESS_TOKEN_INJECT_HEADER.
KEYDRIS_TOKEN_HEADER=authorization

# Point at a stub to exercise the flow without calling GitHub for real.
GITHUB_API_BASE=https://api.github.com

# Comma-separated Hosts to accept. Localhost needs no allowlist; behind any other
# hostname the MCP SDK answers 421 until it is named here.
# KEYDRIS_ALLOWED_HOSTS=mcp.example.com,mcp.example.com:*
