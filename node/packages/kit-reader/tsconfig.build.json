{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Outside dist/, which is the published artifact — the build cache is not.
    "tsBuildInfoFile": "./tsconfig.build.tsbuildinfo",
    // Maps would resolve to ../src, which files:["dist"] does not publish.
    "sourceMap": false
  },
  "exclude": ["src/**/*.test.ts"]
}
