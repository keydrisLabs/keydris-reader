{
  "name": "@keydris/kit-reader",
  "version": "0.1.0",
  "description": "Redeem a single-use Keydris KIT action token for the credential an MCP server needs upstream",
  "license": "Apache-2.0",
  "author": "Keydris Labs",
  "keywords": [
    "keydris",
    "mcp",
    "model-context-protocol",
    "credentials",
    "secrets",
    "kit"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keydrisLabs/keydris-reader.git",
    "directory": "node/packages/kit-reader"
  },
  "homepage": "https://github.com/keydrisLabs/keydris-reader/tree/main/node/packages/kit-reader#readme",
  "bugs": {
    "url": "https://github.com/keydrisLabs/keydris-reader/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "default": "./dist/express.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/*.test.ts",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "express": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "express": "^5.1.0",
    "tsx": "^4.20.3",
    "typescript": "^5.7.3"
  }
}
