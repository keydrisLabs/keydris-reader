# Port this MCP server listens on. Whatever the proxy dials must match, because
# the proxy's `dst_addr` becomes the token's `dst`, and the gateway looks up the
# credential by that host.
PORT=8787

# Control plane's redemption endpoint.
KEYDRIS_GATEWAY_URL=http://localhost:8080/gateway/credentials

# The header the proxy injects the access token on. Must match the control
# plane's ACCESS_TOKEN_INJECT_HEADER.
KEYDRIS_TOKEN_HEADER=authorization

# Point at a stub to exercise the flow without calling GitHub for real.
GITHUB_API_BASE=https://api.github.com
